   ]
  },
  {
   "name": "Cookies",
   "request": {
    "method": "GET",
    "url": {
     "raw": "{{base}}/cookies/set?sess=abc",
     "host": [
      "{{base}}"
     ],
     "path": [
      "cookies",
      "set"
     ],
     "query": [
      {
       "key": "sess",
       "value": "abc"
      }
     ]
    },
    "header": []
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('cookie roundtrip', () => pm.expect(pm.response.json().cookies.sess).to.eql('abc'));",
       "pm.test('pm.cookies', () => pm.expect(pm.cookies.has('sess')).to.be.true);",
       "const jar = pm.cookies.jar(); jar.set(pm.environment.get('base'), 'manual', 'm1', (err) => { pm.test('jar set no error', () => pm.expect(err).to.be.null); });"
      ],
