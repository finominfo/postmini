  },
  {
   "name": "sendRequest + async + timers",
   "request": {
    "method": "GET",
    "url": {
     "raw": "{{base}}/get",
     "host": [
      "{{base}}"
     ],
     "path": [
      "get"
     ]
    },
    "header": []
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "exec": [
       "pm.sendRequest(pm.environment.get('base') + '/headers', (err, res) => { pm.environment.set('sr', res.code); });",
       "const r = await pm.sendRequest({ url: pm.environment.get('base') + '/post', method: 'POST', header: {'X-A': '1'}, body: { mode: 'raw', raw: JSON.stringify({q: 1}) } });",
       "pm.variables.set('srAsync', r.json().data);",
       "await new Promise(res => setTimeout(res, 200));",
       "pm.variables.set('afterTimer', 'done');"
      ],
      "type": "text/javascript"
     }
    },
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('sendRequest cb', () => pm.expect(pm.environment.get('sr')).to.eql(200));",
       "pm.test('sendRequest await', () => pm.expect(pm.variables.get('srAsync')).to.eql('{\"q\":1}'));",
       "pm.test('timer', () => pm.expect(pm.variables.get('afterTimer')).to.eql('done'));",
       "pm.test('async test', async () => { await new Promise(r => setTimeout(r, 50)); pm.expect(1).to.eql(1); });",
       "pm.test.skip('skipped one', () => {});"
      ],
      "type": "text/javascript"
     }
    }
   ]
  },
  {
   "name": "Pre-request modifies request",
   "request": {
    "method": "GET",
    "url": {
     "raw": "{{base}}/get",
     "host": [
      "{{base}}"
     ],
     "path": [
      "get"
     ]
    },
    "header": []
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "exec": [
       "pm.request.headers.add({key: 'X-Added', value: 'yes'}); pm.request.url.query.add({key: 'q', value: '42'}); pm.request.headers.upsert({key: 'X-Up', value: '{{user}}'});"
      ],
      "type": "text/javascript"
     }
    },
    {
     "listen": "test",
     "script": {
      "exec": [
       "const j = pm.response.json(); pm.test('header added', () => pm.expect(j.headers['x-added']).to.eql('yes')); pm.test('query added', () => pm.expect(j.args.q).to.eql('42')); pm.test('upsert resolved', () => pm.expect(j.headers['x-up']).to.eql(pm.iterationData.get('user')));"
      ],
      "type": "text/javascript"
     }
    }
   ]
  },
